<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@../style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lexsolo.controller.RendezVousController">
   <top>
       <fx:include source="TopNav.fxml" />
   </top>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label styleClass="label-title" text="Calendrier Rendez-vous" />
            <TableView fx:id="rdvTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" text="ID" />
                  <TableColumn fx:id="colDate" text="Date/Heure" />
                  <TableColumn fx:id="colMotif" text="Motif" />
                  <TableColumn fx:id="colClient" text="Client" />
                  <TableColumn fx:id="colDossier" text="Dossier" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
   <right>
      <VBox spacing="15.0" styleClass="card" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label styleClass="label-subtitle" text="Détails Rendez-vous" />
            <DatePicker fx:id="datePicker" maxWidth="Infinity" promptText="Date" />
            <TextField fx:id="timeField" promptText="Heure (HH:mm)" />
            <TextField fx:id="motifField" promptText="Motif" />
            <ComboBox fx:id="clientCombo" maxWidth="Infinity" promptText="Client" />
            <ComboBox fx:id="dossierCombo" maxWidth="Infinity" promptText="Dossier (Optionnel)" />
            
            <HBox spacing="10.0">
               <children>
                  <Button onAction="#handleAdd" styleClass="button-primary" text="Ajouter" />
                  <Button onAction="#handleUpdate" styleClass="button-secondary" text="Modifier" />
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Button onAction="#handleDelete" styleClass="button-danger" text="Supprimer" />
                  <Button onAction="#handleClear" styleClass="button-nav" text="Vider" textFill="#6b7280" />
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets bottom="20.0" right="20.0" top="20.0" />
         </BorderPane.margin>
      </VBox>
   </right>
</BorderPane>

