<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<StackPane stylesheets="@../style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lexsolo.controller.AuthController">
    <children>
        <!-- Main Container (Centered Card) -->
        <VBox alignment="CENTER" maxWidth="400.0" spacing="20.0" styleClass="card">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>
                <!-- Logo Section -->
                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <!-- Placeholder for Logo Icon -->
                        <Label text="⚖" textFill="#d97706">
                            <font>
                                <Font size="40.0" />
                            </font>
                        </Label>
                        <Label styleClass="label-header" text="LEXSOLO">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label styleClass="label-subtitle" text="MANAGER" textFill="#1e3a8a">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <Line endX="100.0" startX="-100.0" stroke="#e5e7eb" />

                <Label styleClass="label-title" text="CONNEXION" />
                <Label styleClass="label-subtitle" text="Système de Gestion" />

                <!-- Login Form -->
                <VBox spacing="15.0">
                    <children>
                        <TextField fx:id="usernameField" promptText="Identifiant" />
                        <PasswordField fx:id="passwordField" promptText="Mot de passe" />
                        <HBox alignment="CENTER_LEFT" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogin" styleClass="button-primary" text="SE CONNECTER" />
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </VBox>

                <Label fx:id="errorLabel" textFill="RED" wrapText="true" />

                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <HBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Label text="Pas encore de compte ?" textFill="#6b7280" />
                                <Hyperlink onAction="#handleSignup" text="Créer un compte" textFill="#1e3a8a" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</StackPane>
